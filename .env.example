# 飞书应用凭证（在飞书开放平台创建企业自建应用后获取）
# 属于敏感信息：复制本文件为 .env.local 后填入真实值，切勿提交真实凭证。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书应用凭证来源的域名：飞书为 https://open.feishu.cn，Lark 为 https://open.larksuite.com
FEISHU_APP_DOMAIN=https://open.feishu.cn

# 飞书用户 OAuth 回调地址：必须与开放平台后台登记的重定向 URL 完全一致。
# 示例：https://crm.example.com/api/auth/feishu/callback
FEISHU_OAUTH_REDIRECT_URI=

# 飞书用户身份授权 scope（空格分隔）。按开放平台后台已开通的用户身份权限填写。
FEISHU_OAUTH_SCOPE=

# 服务端会话签名密钥：必须是至少 32 个字符的独立随机值。
# 生成方式：openssl rand -base64 32
# 属于敏感信息：只写入 .env.local，切勿提交真实值。
SESSION_SECRET=

# 定时同步端点密钥：云端调度器调用 POST /api/cron/sync-contacts 时，
# 必须带上请求头 `Authorization: Bearer <CRON_SECRET>`（Vercel Cron 会自动带上）。
# 未配置（或留空）时该端点一律返回 503 且不执行同步（fail closed）。
# 生成方式：openssl rand -base64 32
# 属于敏感信息：只写入 .env.local 与云端环境变量，切勿提交真实值。
CRON_SECRET=

# CRM 站点对外地址（可选）。卡片里的「打开客户档案」按钮用它拼绝对链接，
# 例如 https://crm.example.com。本地不填时按钮仍会返回相对路径。
APP_BASE_URL=

# Postgres 数据库连接串（Prisma 使用）。
# 形如：postgresql://<用户>:<密码>@<主机>:<端口>/<数据库名>
DATABASE_URL=postgresql://user:password@localhost:5432/fscrm?schema=public
