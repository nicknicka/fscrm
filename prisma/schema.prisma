// Prisma schema for fscrm — a Feishu-integrated CRM.
//
// 领域词汇对齐根目录 GLOSSARY.md：客户、联系人、线索、商机、销售阶段、
// 跟进、负责人、客户生命周期等。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 客户等级：对客户价值或重要程度的分级。
enum CustomerLevel {
  HIGH
  MEDIUM
  LOW
}

/// 客户生命周期：客户从线索、成交到留存/流失的整体阶段。
enum CustomerLifecycle {
  LEAD // 线索
  WON // 成交
  RETAINED // 留存
  CHURNED // 流失
}

/// CRM 用户角色：普通负责人或管理员。
enum UserRole {
  OWNER // 普通负责人，仅能访问自己负责的业务对象
  ADMIN // 管理员，可访问与管理全部业务对象
}

/// 销售阶段：商机在成交路径上所处的阶段。
enum OpportunityStage {
  CONTACT // 初步接触
  NEED_CONFIRM // 需求确认
  QUOTE // 报价
  NEGOTIATE // 谈判
  WON // 赢单
  LOST // 输单
}

/// 线索状态：线索在培育路径上的状态。
enum LeadStatus {
  NEW // 新线索
  FOLLOWING // 跟进中
  CONVERTED // 已转化
  INVALID // 无效
}

/// 跟进方式：跟进时使用的沟通渠道。
enum FollowUpMode {
  CALL // 电话
  MEETING // 面谈
  EMAIL // 邮件
  IM // 即时消息
  OTHER // 其他
}

/// 部门：由飞书通讯录同步而来。
model Department {
  id               String  @id @default(uuid())
  /// 飞书部门 ID，作为同步的唯一键。
  feishuDepartmentId String @unique
  /// 开放部门 ID。
  openDepartmentId String?
  name             String
  /// 父部门在 CRM 中的 ID。
  parentId         String?
  /// 部门负责人（飞书用户 ID）。
  leaderFeishuUserId String?
  memberCount      Int?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

/// CRM 用户（负责人）：可绑定飞书用户，是消息接收与操作归属的主体。
model User {
  id            String   @id @default(uuid())
  name          String
  email         String?
  avatarUrl     String?
  /// 飞书开放 ID，用于与飞书用户稳定匹配（身份绑定）。
  feishuOpenId  String?  @unique
  feishuUnionId String?
  feishuUserId  String?
  /// 角色：普通负责人或管理员；新用户默认按普通负责人处理。
  role         UserRole @default(OWNER)
  /// 所属部门。
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  customers      Customer[]
  opportunities  Opportunity[]
  leads          Lead[]
  followUps      FollowUp[]
  dashboardConfig DashboardConfig?
  salesTargets   SalesTarget[]
  salesTasks     SalesTask[]
  apiKeys        ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// 客户：CRM 的核心业务对象。
model Customer {
  id         String        @id @default(uuid())
  name       String
  level      CustomerLevel @default(MEDIUM)
  /// 客户生命周期阶段：**人工维护**的销售阶段，新客户默认处于线索阶段。
  /// 不由 Lead.status 或 Opportunity.stage 自动派生；是否需要推进由负责人自行判断。
  lifecycle  CustomerLifecycle @default(LEAD)
  industry   String?
  phone      String?
  email      String?
  address    String?
  remark     String?
  /// 自定义字段：key -> 文本值的 JSON 对象（先覆盖客户，字段 key 由配置目录定义）。
  customFields Json?
  /// 负责人，对应 User。
  ownerId    String?
  owner      User?         @relation(fields: [ownerId], references: [id])

  contacts   Contact[]
  opportunities Opportunity[]
  followUps  FollowUp[]
  quotations Quotation[]
  contracts  Contract[]
  orders     Order[]
  chatBindings ChatBinding[]
  salesTasks SalesTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

/// 联系人：与客户关联的具体人员。
model Contact {
  id         String  @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  phone      String?
  email      String?
  remark     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

/// 线索：尚未明确成交意向的原始客户信息。
model Lead {
  id         String     @id @default(uuid())
  name       String
  /// 线索来源：表单、转介绍、市场活动等。
  source     String?
  status     LeadStatus  @default(NEW)
  /// 负责人，对应 User。
  ownerId    String?
  owner      User?       @relation(fields: [ownerId], references: [id])
  contactPhone String?
  contactEmail String?
  remark     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

/// 商机：已识别出明确意向、进入销售流程的销售机会。
model Opportunity {
  id                String           @id @default(uuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name              String
  stage             OpportunityStage  @default(CONTACT)
  /// 预计成交金额。
  amount            Float?
  /// 预计成交日期。
  expectedCloseDate DateTime?
  /// 负责人，对应 User。
  ownerId           String?
  owner             User?            @relation(fields: [ownerId], references: [id])
  remark            String?

  followUps         FollowUp[]
  quotations        Quotation[]
  contracts         Contract[]
  orders            Order[]
  discountApprovals DiscountApproval[]
  salesTasks        SalesTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("opportunities")
}

/// 跟进记录：对某次跟进的时间、方式、内容与下一步的结构化记录。
model FollowUp {
  id          String       @id @default(uuid())
  /// 关联的客户；跟进可挂在客户或商机下，二者至少有一个。
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 关联的商机。
  opportunityId String?
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// 跟进人，对应 User。
  ownerId     String?
  owner       User?        @relation(fields: [ownerId], references: [id])
  mode        FollowUpMode
  content     String
  /// 下一步计划跟进时间。
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("follow_ups")
}

/// 报价状态：报价在确认路径上所处的状态。
enum QuotationStatus {
  DRAFT // 草稿
  CONFIRMED // 已确认
  CANCELLED // 已取消
}

/// 报价：针对商机向客户提出的价格方案；金额由报价条目汇总。
model Quotation {
  id            String          @id @default(uuid())
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        QuotationStatus @default(DRAFT)
  /// 金额：始终由 items 的数量乘以单价汇总维护。
  amount        Float           @default(0)
  items         QuotationItem[]
  contracts     Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quotations")
}

/// 报价条目：报价中的单项名称、数量与单价。
model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int
  unitPrice   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quotation_items")
}

/// 合同状态：合同在生效路径上所处的状态。
enum ContractStatus {
  DRAFT // 草稿
  EFFECTIVE // 生效
  VOID // 作废
}

/// 合同：由已确认报价转化而来，关联客户、商机与来源报价。
model Contract {
  id                String         @id @default(uuid())
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId     String
  opportunity       Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceQuotationId String         @unique
  sourceQuotation   Quotation      @relation(fields: [sourceQuotationId], references: [id])
  status            ContractStatus @default(DRAFT)
  /// 金额从来源报价继承，不由表单提交。
  amount            Float
  orders            Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contracts")
}

/// 订单状态：订单在履约路径上所处的状态。
enum OrderStatus {
  PENDING // 待履约
  FULFILLING // 履约中
  COMPLETED // 已完成
  CANCELLED // 已取消
}

/// 订单：由合同转化而来，关联客户、商机与来源合同，进入履约阶段。
model Order {
  id               String      @id @default(uuid())
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceContractId String      @unique
  sourceContract   Contract    @relation(fields: [sourceContractId], references: [id])
  status           OrderStatus @default(PENDING)
  /// 金额从来源合同继承，不由表单提交。
  amount           Float

  payments      Payment[]
  paymentPlans  PaymentPlan[]
  reconciliations Reconciliation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

/// 对账记录：管理员确认某订单截至某时的回款核对结果，保留当时的金额快照。
model Reconciliation {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 确认时的已回款合计快照。
  receivedTotal Float
  /// 确认时的未收差额快照（订单金额 - 已回款合计）。
  balance     Float
  /// 确认人（CRM 用户 ID）。
  confirmedBy String
  /// 备注（可选）。
  note        String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("reconciliations")
}

enum DiscountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// 折扣审批：负责人为商机申请折扣，管理员审批；通过后按折扣调整商机金额。
model DiscountApproval {
  id           String                 @id @default(uuid())
  opportunityId String
  opportunity  Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// 申请折扣率（0-1，如 0.1 表示九折）。
  discountRate Float
  /// 申请理由。
  reason       String
  /// 申请人（CRM 用户 ID）。
  requestedBy  String
  status       DiscountApprovalStatus @default(PENDING)
  /// 审批人（管理员 ID），审批后写入。
  reviewedBy   String?
  /// 审批备注。
  reviewNote   String?
  reviewedAt   DateTime?
  /// 审批通过时记录的商机原金额，便于追溯折扣来源。
  originalAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId, createdAt])
  @@map("discount_approvals")
}

enum SalesTaskType {
  TASK
  SCHEDULE
}

enum SalesTaskStatus {
  OPEN
  DONE
}

/// 任务与日程：销售待办与日程计划，可关联客户/商机，按负责人可见。
model SalesTask {
  id           String          @id @default(uuid())
  type         SalesTaskType   @default(TASK)
  title        String
  description  String?
  /// 计划时间（任务截止 / 日程开始）。
  dueAt        DateTime
  status       SalesTaskStatus @default(OPEN)
  /// 负责人。
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id])
  /// 关联客户/商机（可选）。
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity  Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, dueAt])
  @@map("sales_tasks")
}

/// 业绩目标：按负责人与月份（YYYY-MM）设置的目标金额。
model SalesTarget {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 月份，格式 YYYY-MM。
  month     String
  /// 目标金额（元）。
  amount    Float
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@map("sales_targets")
}

/// 销售阶段配置：管理枚举阶段的显示名、顺序与启停（阶段值本身仍是枚举，不可新增）。
model OpportunityStageConfig {
  stage    OpportunityStage @id
  /// 界面显示名，管理员可改。
  label    String
  /// 排序序号，越小越靠前。
  position Int
  /// 是否启用；停用的阶段不在表单与漏斗中显示。
  isActive Boolean @default(true)
  /// 徽章色调。
  tone     String  @default("blue")

  @@map("opportunity_stage_configs")
}

/// 用户仪表盘配置：每位用户自定义首页展示的卡片集合（有序）。
model DashboardConfig {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 卡片 key 的有序列表，JSON 数组字符串。
  cards     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_configs")
}

/// 回款计划：为订单登记的计划回款金额与时间，与实际回款对照。
model PaymentPlan {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 计划回款金额（元）。
  amount      Float
  /// 计划到账时间。
  plannedAt   DateTime
  /// 备注（可选）。
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, plannedAt])
  @@map("payment_plans")
}

/// 回款：客户为订单实际支付的款项，一笔订单可登记多笔回款。
model Payment {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 回款金额。
  amount     Float
  /// 到账时间。
  receivedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

/// 飞书 OAuth state 的一次性记录：登录时登记，回调时原子消费。
///
/// 存放在数据库而非进程内 Map，使一次性校验在多实例部署与进程重启后仍然生效。
/// 过期记录在每次消费时顺手回收（见 src/lib/auth/oauth-state.ts）。
model OAuthState {
  id     String @id @default(uuid())
  /// OAuth state 原文；唯一约束保证同一 state 只能登记一次。
  state  String @unique
  /// 过期时间；超过后不再可消费，并会被回收。
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("oauth_states")
}

/// 模型配置：OpenAI 兼容接口的连接参数，用于解析飞书消息里的跟进内容。
///
/// 只保留一条当前生效的记录（`isActive` 为 true），设置页保存时在同一事务里
/// 切换启用状态，避免出现两条同时生效的配置。`apiKey` 只存密文，读接口不返回明文。
model ModelConfig {
  id        String  @id @default(uuid())
  /// 服务商显示名，如「DeepSeek」「通义千问」，仅用于界面展示。
  label     String
  /// OpenAI 兼容的接口根地址，如 https://api.deepseek.com/v1。
  baseUrl   String
  /// 模型 ID，如 deepseek-chat。
  model     String
  /// API Key 密文（AES-256-GCM，密钥来自 SESSION_SECRET 派生）。
  apiKeyCipher String
  /// 是否当前生效。
  isActive  Boolean @default(true)
  /// 最近一次连通性测试的时间与结果，便于设置页展示。
  lastTestedAt   DateTime?
  lastTestOk     Boolean?
  lastTestMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("model_configs")
}

/// 飞书会话绑定：把某个飞书群/单聊绑定到某个客户，用于把群里的沟通落成跟进记录。
model ChatBinding {
  id        String   @id @default(uuid())
  /// 飞书 chat_id。
  chatId    String   @unique
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 绑定人。
  boundByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_bindings")
}

/// API Key：外部系统只读访问业务数据的凭据（仅存哈希，明文只展示一次）。
model ApiKey {
  id        String    @id @default(uuid())
  /// key 的 SHA-256 哈希，用于鉴权比对。
  keyHash   String    @unique
  /// 可读名称，便于识别用途。
  label     String
  /// 关联用户：API 以该用户的权限范围读数据。
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

/// 字段级权限：按角色 × 对象 × 字段配置可见性（先覆盖客户敏感字段）。
model FieldPermission {
  id      String   @id @default(uuid())
  role    UserRole
  entity  String
  /// 字段名（如 phone / email / address）。
  field   String
  /// 是否可见；不可见时服务端返回 null，不泄露真实值。
  visible Boolean @default(true)

  @@unique([role, entity, field])
  @@map("field_permissions")
}

/// 业务审计日志：记录关键业务数据的增删改（谁、何时、改了什么）。与飞书集成日志区分。
model AuditLog {
  id         String   @id @default(uuid())
  /// 操作人 CRM 用户 ID（系统操作可为 null）。
  actorId    String?
  /// 操作人姓名快照，避免用户改名/删除后丢失。
  actorName  String
  /// 动作：CREATE / UPDATE / DELETE / CONVERT / APPROVE 等。
  action     String
  /// 对象类型：Customer / Opportunity / Order / Payment 等。
  entityType String
  /// 对象 ID。
  entityId   String
  /// 变更摘要（人可读）。
  summary    String

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// 飞书消息去重：飞书可能重复推送同一事件，按 message_id 幂等。
model FeishuMessageLog {
  messageId String   @id
  /// 处理结果：handled / ignored / failed。
  outcome   String
  /// 关联生成的跟进记录（若本次通过消息创建了跟进）。
  followUpId String?

  createdAt DateTime @default(now())

  @@map("feishu_message_logs")
}

/// 卡片按钮操作审计：记录谁在飞书里点了哪个按钮、改了什么业务数据。
model CardActionLog {
  id         String   @id @default(uuid())
  /// 卡片动作类型，如 claim_customer / advance_stage。
  action     String
  /// 操作人飞书 open_id 与映射到的 CRM 用户。
  operatorOpenId String
  operatorUserId String?
  /// 目标业务对象。
  targetType String
  targetId   String
  /// 动作结果：ok / rejected，附带原因。
  result     String
  detail     String?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@map("card_action_logs")
}
