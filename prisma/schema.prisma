// Prisma schema for fscrm — a Feishu-integrated CRM.
//
// 领域词汇对齐根目录 GLOSSARY.md：客户、联系人、线索、商机、销售阶段、
// 跟进、负责人、客户生命周期等。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 客户等级：对客户价值或重要程度的分级。
enum CustomerLevel {
  HIGH
  MEDIUM
  LOW
}

/// 客户生命周期：客户从线索、成交到留存/流失的整体阶段。
enum CustomerLifecycle {
  LEAD // 线索
  WON // 成交
  RETAINED // 留存
  CHURNED // 流失
}

/// CRM 用户角色：普通负责人或管理员。
enum UserRole {
  OWNER // 普通负责人，仅能访问自己负责的业务对象
  ADMIN // 管理员，可访问与管理全部业务对象
}

/// 销售阶段：商机在成交路径上所处的阶段。
enum OpportunityStage {
  CONTACT // 初步接触
  NEED_CONFIRM // 需求确认
  QUOTE // 报价
  NEGOTIATE // 谈判
  WON // 赢单
  LOST // 输单
}

/// 线索状态：线索在培育路径上的状态。
enum LeadStatus {
  NEW // 新线索
  FOLLOWING // 跟进中
  CONVERTED // 已转化
  INVALID // 无效
}

/// 跟进方式：跟进时使用的沟通渠道。
enum FollowUpMode {
  CALL // 电话
  MEETING // 面谈
  EMAIL // 邮件
  IM // 即时消息
  OTHER // 其他
}

/// 部门：由飞书通讯录同步而来。
model Department {
  id               String  @id @default(uuid())
  /// 飞书部门 ID，作为同步的唯一键。
  feishuDepartmentId String @unique
  /// 开放部门 ID。
  openDepartmentId String?
  name             String
  /// 父部门在 CRM 中的 ID。
  parentId         String?
  /// 部门负责人（飞书用户 ID）。
  leaderFeishuUserId String?
  memberCount      Int?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

/// CRM 用户（负责人）：可绑定飞书用户，是消息接收与操作归属的主体。
model User {
  id            String   @id @default(uuid())
  name          String
  email         String?
  avatarUrl     String?
  /// 飞书开放 ID，用于与飞书用户稳定匹配（身份绑定）。
  feishuOpenId  String?  @unique
  feishuUnionId String?
  feishuUserId  String?
  /// 角色：普通负责人或管理员；新用户默认按普通负责人处理。
  role         UserRole @default(OWNER)
  /// 所属部门。
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  customers      Customer[]
  opportunities  Opportunity[]
  leads          Lead[]
  followUps      FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// 客户：CRM 的核心业务对象。
model Customer {
  id         String        @id @default(uuid())
  name       String
  level      CustomerLevel @default(MEDIUM)
  /// 客户生命周期阶段；新客户默认处于线索阶段。
  lifecycle  CustomerLifecycle @default(LEAD)
  industry   String?
  phone      String?
  email      String?
  address    String?
  remark     String?
  /// 负责人，对应 User。
  ownerId    String?
  owner      User?         @relation(fields: [ownerId], references: [id])

  contacts   Contact[]
  opportunities Opportunity[]
  followUps  FollowUp[]
  quotations Quotation[]
  contracts  Contract[]
  orders     Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

/// 联系人：与客户关联的具体人员。
model Contact {
  id         String  @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  phone      String?
  email      String?
  remark     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

/// 线索：尚未明确成交意向的原始客户信息。
model Lead {
  id         String     @id @default(uuid())
  name       String
  /// 线索来源：表单、转介绍、市场活动等。
  source     String?
  status     LeadStatus  @default(NEW)
  /// 负责人，对应 User。
  ownerId    String?
  owner      User?       @relation(fields: [ownerId], references: [id])
  contactPhone String?
  contactEmail String?
  remark     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

/// 商机：已识别出明确意向、进入销售流程的销售机会。
model Opportunity {
  id                String           @id @default(uuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name              String
  stage             OpportunityStage  @default(CONTACT)
  /// 预计成交金额。
  amount            Float?
  /// 预计成交日期。
  expectedCloseDate DateTime?
  /// 负责人，对应 User。
  ownerId           String?
  owner             User?            @relation(fields: [ownerId], references: [id])
  remark            String?

  followUps         FollowUp[]
  quotations        Quotation[]
  contracts         Contract[]
  orders            Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("opportunities")
}

/// 跟进记录：对某次跟进的时间、方式、内容与下一步的结构化记录。
model FollowUp {
  id          String       @id @default(uuid())
  /// 关联的客户；跟进可挂在客户或商机下，二者至少有一个。
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 关联的商机。
  opportunityId String?
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// 跟进人，对应 User。
  ownerId     String?
  owner       User?        @relation(fields: [ownerId], references: [id])
  mode        FollowUpMode
  content     String
  /// 下一步计划跟进时间。
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("follow_ups")
}

/// 报价状态：报价在确认路径上所处的状态。
enum QuotationStatus {
  DRAFT // 草稿
  CONFIRMED // 已确认
  CANCELLED // 已取消
}

/// 报价：针对商机向客户提出的价格方案；金额由报价条目汇总。
model Quotation {
  id            String          @id @default(uuid())
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        QuotationStatus @default(DRAFT)
  /// 金额：始终由 items 的数量乘以单价汇总维护。
  amount        Float           @default(0)
  items         QuotationItem[]
  contracts     Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quotations")
}

/// 报价条目：报价中的单项名称、数量与单价。
model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int
  unitPrice   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quotation_items")
}

/// 合同状态：合同在生效路径上所处的状态。
enum ContractStatus {
  DRAFT // 草稿
  EFFECTIVE // 生效
  VOID // 作废
}

/// 合同：由已确认报价转化而来，关联客户、商机与来源报价。
model Contract {
  id                String         @id @default(uuid())
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId     String
  opportunity       Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceQuotationId String         @unique
  sourceQuotation   Quotation      @relation(fields: [sourceQuotationId], references: [id])
  status            ContractStatus @default(DRAFT)
  /// 金额从来源报价继承，不由表单提交。
  amount            Float
  orders            Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contracts")
}

/// 订单状态：订单在履约路径上所处的状态。
enum OrderStatus {
  PENDING // 待履约
  FULFILLING // 履约中
  COMPLETED // 已完成
  CANCELLED // 已取消
}

/// 订单：由合同转化而来，关联客户、商机与来源合同，进入履约阶段。
model Order {
  id               String      @id @default(uuid())
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceContractId String      @unique
  sourceContract   Contract    @relation(fields: [sourceContractId], references: [id])
  status           OrderStatus @default(PENDING)
  /// 金额从来源合同继承，不由表单提交。
  amount           Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}
